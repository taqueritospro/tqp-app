# Local environment variables. Copy this file with: cp .env.example .env
# Every value here is a local placeholder; never put real secrets in this file.

# Runtime
APP_ENV=local
PORT=3000

# PostgreSQL container
POSTGRES_USER=tqp_app
POSTGRES_PASSWORD=local-only-change-me
POSTGRES_DB=tqp_app
# Host port for DBeaver, bound to 127.0.0.1 in development mode only
DB_HOST_PORT=5433

# S3-compatible storage (SeaweedFS locally)
S3_ENDPOINT=http://seaweedfs:8333
S3_REGION=us-east-1
S3_BUCKET=tqp-app-local
S3_ACCESS_KEY_ID=local-access-key
S3_SECRET_ACCESS_KEY=local-secret-key-change-me

# Mail (Mailpit locally)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@tqp-app.com

# Internal services
PLANTUML_URL=http://plantuml:8080

# Public origins
WEB_ORIGIN=https://tqp-app.localhost
VITE_API_BASE_URL=https://api.tqp-app.localhost
